---
/**
 * A service's trail-rating mark (visual-identity design D9): the shape,
 * hidden from assistive technology, and the rating's name as visible text,
 * so the rating is never conveyed by color or shape alone. Names come from
 * the legend on the Services page.
 */
import type { CollectionEntry } from 'astro:content'
import { getPage } from '../lib/pages.ts'

interface Props {
  rating: CollectionEntry<'services'>['data']['rating']
}

const { rating } = Astro.props
const legend = (await getPage('services')).data.ratingLegend ?? []
const entry = legend.find((l) => l.rating === rating)
if (!entry) {
  throw new Error(
    `src/content/pages/services.md: the ratingLegend has no entry for ${rating}`
  )
}
---

<span class={`rating rating-${rating}`}>
  <svg
    class="mark"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 16 16"
    width="16"
    height="16"
  >
    {rating === 'green-circle' && (
      <circle cx="8" cy="8" r="7" fill="currentColor" />
    )}
    {rating === 'blue-square' && (
      <rect x="1.5" y="1.5" width="13" height="13" fill="currentColor" />
    )}
    {rating === 'black-diamond' && (
      <path d="M8 1.2 14.8 8 8 14.8 1.2 8Z" fill="currentColor" />
    )}
  </svg>
  <span class="label">{entry.name}</span>
</span>

<style>
  .rating {
    align-items: center;
    display: inline-flex;
    gap: var(--space-2);
  }

  .mark {
    flex: none;
    height: 1em;
    width: 1em;
  }

  .rating-green-circle .mark {
    color: var(--color-rating-green);
  }

  .rating-blue-square .mark {
    color: var(--color-rating-blue);
  }

  .rating-black-diamond .mark {
    color: var(--color-rating-black);
  }

  .rating-black-diamond path {
    stroke: var(--color-rating-outline);
    stroke-width: 1.2;
  }
</style>

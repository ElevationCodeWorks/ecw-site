---
/**
 * The hero drawing for comp R2.A "Plate": an exploded assembly drawn like a
 * parts-catalog plate (src/assets/brand/plate-hero.svg). Decorative, so it is
 * hidden from assistive technology. Its faces and its one yellow surface are
 * colored here with tokens, so it follows both color schemes.
 */
import drawing from '../assets/brand/plate-hero.svg?raw'

const svg = drawing
  .replace(/<!--[\s\S]*?-->\s*/g, '')
  .replace(/<svg\b/, '<svg aria-hidden="true" focusable="false"')
---

<div class="hero-plate">
  <Fragment set:html={svg} />
</div>

<style>
  .hero-plate {
    color: var(--color-text);
  }

  .hero-plate :global(svg) {
    height: auto;
    width: 100%;
  }

  .hero-plate :global(.face) {
    fill: var(--color-bg);
  }

  .hero-plate :global(.side) {
    fill: var(--color-surface);
  }

  .hero-plate :global(.hl) {
    fill: var(--color-highlight);
  }

  .hero-plate :global(.assembly) {
    stroke-dasharray: 4 4;
  }

  .hero-plate :global(.frame) {
    stroke: var(--color-border);
  }
</style>

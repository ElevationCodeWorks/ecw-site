---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'work'>
  level?: 2 | 3
  /** Load this screenshot first (the page's largest image). */
  priority?: boolean
}

const { project, level = 2, priority = false } = Astro.props
const Heading = `h${level}` as 'h2' | 'h3'
const shot =
  project.data.screenshots.find((s) => s.viewport === 'desktop') ??
  project.data.screenshots[0]
// A plate shows the whole width of its screenshot. A shot taller than 16:10
// is cropped from the top to that shape; a wider one keeps its own.
const plate = Math.max(1.6, shot.image.width / shot.image.height)
const sizes = '(min-width: 80rem) 27rem, (min-width: 40rem) 34vw, 100vw'
---

<article class="preview" style={`--plate: ${+plate.toFixed(4)}`}>
  <Picture
    src={shot.image}
    alt={shot.alt}
    formats={['avif', 'webp']}
    widths={[480, 960, 1440]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  <div class="details">
    <Heading>
      <a href={`/work/${project.id}/`}>{project.data.name}</a>
    </Heading>
    <p>{project.data.description}</p>
    <p class="role">{project.data.role}</p>
  </div>
</article>

<style>
  /*
   * A catalog listing: the screenshot in the narrow column, the entry's
   * details in the wide one, on the page's split.
   */
  .preview {
    --shot-width: calc((100% - var(--split-gap)) * 3 / 8);
    align-items: start;
    border-top: var(--rule-width) solid var(--color-accent);
    display: grid;
    gap: var(--space-4) var(--split-gap);
    grid-template-columns: var(--split);
    padding-top: var(--space-5);
    position: relative;
  }

  /*
   * The list is one table: the Red Rocks rule opens it, and a hairline
   * divides each listing from the one before.
   */
  .preview + .preview {
    border-top: var(--border-width) solid var(--color-border);
  }

  /*
   * A plate never cuts the sides of its screenshot: one taller than 16:10
   * is cropped from the top, a wider one keeps its own shape (--plate).
   */
  .preview :global(img) {
    aspect-ratio: var(--plate);
    border: var(--border-width) solid var(--color-border);
    height: auto;
    object-fit: cover;
    object-position: top center;
    width: 100%;
  }

  /* The list closes with a hairline, like every other table. */
  .preview:last-of-type {
    border-bottom: var(--border-width) solid var(--color-border);
    padding-bottom: var(--space-5);
  }

  .preview a {
    color: var(--color-text);
  }

  /*
   * The screenshot opens the case study too: the name's link reaches over
   * the plate, so pointing at either marks the name, and the text beside it
   * can still be selected.
   */
  .preview a::after {
    aspect-ratio: var(--plate);
    content: '';
    left: 0;
    position: absolute;
    top: var(--space-5);
    width: var(--shot-width);
  }

  /* One measure for the entry, so its rule ends where its text does. */
  .details {
    max-width: 34rem;
  }

  /*
   * The name is set at one size whatever its heading level (h3 on Home, h2
   * on Work), and its capitals line up with the top edge of the screenshot.
   */
  .details > :first-child {
    font-size: var(--text-xl);
    text-box-edge: cap alphabetic;
    text-box-trim: trim-start;
  }

  .details > * + * {
    margin-top: var(--space-2);
  }

  .details p {
    max-width: none;
  }

  .details .role {
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
  }

  @media (max-width: 40rem) {
    .preview {
      --shot-width: 100%;
      grid-template-columns: 1fr;
    }
  }
</style>

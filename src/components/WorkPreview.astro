---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'work'>
  level?: 2 | 3
  /** Load this screenshot first (the page's largest image). */
  priority?: boolean
}

const { project, level = 2, priority = false } = Astro.props
const Heading = `h${level}` as 'h2' | 'h3'
const shot =
  project.data.screenshots.find((s) => s.viewport === 'desktop') ??
  project.data.screenshots[0]
---

<article class="preview">
  <div class="shot">
    <Picture
      src={shot.image}
      alt={shot.alt}
      formats={['avif', 'webp']}
      widths={[480, 960, 1440]}
      sizes="(min-width: 72rem) 36rem, 100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
    {/* Printer's crop marks just outside the screenshot's corners. */}
    <svg
      class="crop"
      aria-hidden="true"
      focusable="false"
      stroke="currentColor"
      overflow="visible"
    >
      <svg x="0" y="0" overflow="visible">
        <line x1="-6" y1="0" x2="-18" y2="0" />
        <line x1="0" y1="-6" x2="0" y2="-18" />
      </svg>
      <svg x="100%" y="0" overflow="visible">
        <line x1="6" y1="0" x2="18" y2="0" />
        <line x1="0" y1="-6" x2="0" y2="-18" />
      </svg>
      <svg x="0" y="100%" overflow="visible">
        <line x1="-6" y1="0" x2="-18" y2="0" />
        <line x1="0" y1="6" x2="0" y2="18" />
      </svg>
      <svg x="100%" y="100%" overflow="visible">
        <line x1="6" y1="0" x2="18" y2="0" />
        <line x1="0" y1="6" x2="0" y2="18" />
      </svg>
    </svg>
  </div>
  <div class="stack-tight">
    <Heading>
      <a href={`/work/${project.id}/`}>{project.data.name}</a>
    </Heading>
    <p>{project.data.description}</p>
    <p class="role">{project.data.role}</p>
  </div>
</article>

<style>
  /* A catalog listing: the screenshot beside the entry's details. */
  .preview {
    align-items: start;
    border-top: var(--rule-width) solid var(--color-accent);
    display: grid;
    gap: var(--space-4) var(--space-6);
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    padding-top: var(--space-5);
  }

  .shot {
    margin: var(--space-4);
    position: relative;
  }

  .shot :global(img) {
    border: var(--border-width) solid var(--color-border);
  }

  .crop {
    color: var(--color-text-muted);
    height: 100%;
    inset: 0;
    pointer-events: none;
    position: absolute;
    width: 100%;
  }

  .preview a {
    color: var(--color-text);
  }

  .role {
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    padding-top: var(--space-2);
  }

  @media (max-width: 40rem) {
    .preview {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'work'>
  level?: 2 | 3
  /** Load this screenshot first (the page's largest image). */
  priority?: boolean
}

const { project, level = 2, priority = false } = Astro.props
const Heading = `h${level}` as 'h2' | 'h3'
const shot =
  project.data.screenshots.find((s) => s.viewport === 'desktop') ??
  project.data.screenshots[0]
---

<article class="preview">
  <Picture
    src={shot.image}
    alt={shot.alt}
    formats={['avif', 'webp']}
    widths={[480, 960, 1440]}
    sizes="(min-width: 72rem) 36rem, 100vw"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  <div class="details">
    <Heading>
      <a href={`/work/${project.id}/`}>{project.data.name}</a>
    </Heading>
    <p>{project.data.description}</p>
    <p class="role">{project.data.role}</p>
  </div>
</article>

<style>
  /*
   * A catalog listing: the screenshot in the narrow column, the entry's
   * details in the wide one, on the page's split.
   */
  .preview {
    align-items: start;
    border-top: var(--rule-width) solid var(--color-accent);
    display: grid;
    gap: var(--space-4) var(--split-gap);
    grid-template-columns: var(--split);
    padding-top: var(--space-5);
  }

  .preview :global(img) {
    border: var(--border-width) solid var(--color-border);
  }

  .preview a {
    color: var(--color-text);
  }

  /* One measure for the entry, so its rule ends where its text does. */
  .details {
    max-width: 34rem;
  }

  /* The name's capitals line up with the top edge of the screenshot. */
  .details > :first-child {
    text-box-edge: cap alphabetic;
    text-box-trim: trim-start;
  }

  .details > * + * {
    margin-top: var(--space-2);
  }

  .details p {
    max-width: none;
  }

  .details .role {
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
  }

  @media (max-width: 40rem) {
    .preview {
      grid-template-columns: 1fr;
    }
  }
</style>

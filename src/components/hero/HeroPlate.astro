---
/**
 * Hero option "Drafting table" for comp R2.A Plate: the exploded assembly
 * (src/assets/brand/plate-hero.svg) draws itself line by line, as on a
 * drafting table, and its parts slide together as the visitor scrolls past.
 * CSS only. Every animation sits inside a no-preference reduced-motion query
 * (design D14), so visitors who prefer reduced motion see the finished drawing.
 * Decorative, so it is hidden from assistive technology.
 */
import drawing from '../../assets/brand/plate-hero.svg?raw'

const svg = drawing
  .replace(/<!--[\s\S]*?-->\s*/g, '')
  .replace(/<svg\b/, '<svg aria-hidden="true" focusable="false"')
  // A path length of 1 lets every line draw on with the same dash animation.
  .replace(/<(polygon|line|rect|circle)\b/g, '<$1 pathLength="1"')
---

<div class="hero-plate">
  <Fragment set:html={svg} />
</div>

<style>
  .hero-plate {
    color: var(--color-text);
  }

  .hero-plate :global(svg) {
    height: auto;
    overflow: visible;
    width: 100%;
  }

  .hero-plate :global(.face) {
    fill: var(--color-bg);
  }

  .hero-plate :global(.side) {
    fill: var(--color-surface);
  }

  .hero-plate :global(.hl) {
    fill: var(--color-highlight);
  }

  .hero-plate :global(.assembly) {
    stroke-dasharray: 0.03 0.03;
  }

  .hero-plate :global(rect.frame) {
    stroke: var(--color-border);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-plate {
      view-timeline: --plate block;
    }

    /* Each group starts a beat after the last. */
    .hero-plate :global(.frame) {
      --d: 0s;
    }

    .hero-plate :global(.base) {
      --d: 0.35s;
    }

    .hero-plate :global(.deck) {
      --d: 0.7s;
    }

    .hero-plate :global(.lid) {
      --d: 1.05s;
    }

    .hero-plate :global(.callouts) {
      --d: 1.5s;
    }

    /* Every line draws on. */
    .hero-plate
      :global(:is(.frame, .part, .callouts) :is(polygon, line, rect, circle)) {
      animation: draw 0.9s cubic-bezier(0.6, 0, 0.2, 1) var(--d) both;
      stroke-dasharray: 1;
    }

    /* Then its faces fill in, and the yellow lands last. */
    .hero-plate :global(:is(polygon, circle):is(.face, .side)) {
      animation:
        draw 0.9s cubic-bezier(0.6, 0, 0.2, 1) var(--d) both,
        fill-in 0.5s ease-out calc(var(--d) + 0.8s) both;
    }

    .hero-plate :global(polygon.hl) {
      animation:
        draw 0.9s cubic-bezier(0.6, 0, 0.2, 1) var(--d) both,
        fill-in 0.4s ease-out 2.4s both;
    }

    .hero-plate :global(.assembly) {
      animation: appear 0.6s ease-out 2s both;
    }

    /* Scrolling past, the exploded parts slide together. */
    .hero-plate :global(:is(.lid, .base)) {
      animation-fill-mode: both;
      animation-range: exit 0% exit 80%;
      animation-timeline: --plate;
      transform-box: view-box;
    }

    .hero-plate :global(.lid) {
      animation-name: lid-assemble;
    }

    .hero-plate :global(.base) {
      animation-name: base-assemble;
    }

    @keyframes lid-assemble {
      to {
        translate: 0 50px;
      }
    }

    @keyframes base-assemble {
      to {
        translate: 0 -40px;
      }
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fill-in {
    from {
      fill-opacity: 0;
    }

    to {
      fill-opacity: 1;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>

---
import { nav, site } from '../site.config.ts'

const path = Astro.url.pathname

/** "page" for the exact page, "true" for pages inside that section. */
function currentState(href: string): 'page' | 'true' | undefined {
  if (path === href) return 'page'
  if (path.startsWith(href)) return 'true'
  return undefined
}
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      {site.brandName}
    </a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={currentState(item.href)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    justify-content: space-between;
    margin-inline: auto;
    max-width: var(--container);
    padding: var(--space-4) var(--gutter);
  }

  .brand {
    color: var(--color-text);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--color-text);
  }

  nav a[aria-current] {
    font-weight: var(--weight-bold);
    text-decoration-thickness: var(--focus-width);
  }
</style>

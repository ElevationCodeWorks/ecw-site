---
import Symbol from './Symbol.astro'
import { nav, site } from '../site.config.ts'

const path = Astro.url.pathname

/** "page" for the exact page, "true" for pages inside that section. */
function currentState(href: string): 'page' | 'true' | undefined {
  if (path === href) return 'page'
  if (path.startsWith(href)) return 'true'
  return undefined
}
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <Symbol class="symbol" />
      {site.brandName}
    </a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={currentState(item.href)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* A letterhead: the name, the stamp, and a thin rule in stamp red. */
  .site-header {
    border-bottom: var(--rule-width) solid var(--color-accent);
  }

  .inner {
    display: grid;
    gap: var(--space-3);
    margin-inline: auto;
    max-width: var(--container);
    padding: var(--space-6) var(--gutter) var(--space-4);
  }

  .brand {
    align-items: center;
    color: var(--color-text);
    display: inline-flex;
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    gap: var(--space-3);
    justify-self: start;
    text-decoration: none;
  }

  .brand :global(.symbol) {
    color: var(--color-accent);
    flex: none;
    height: 1.2em;
    width: 1.2em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
  }

  nav a:hover {
    color: var(--color-link-hover);
    text-decoration-color: currentColor;
  }

  nav a[aria-current] {
    font-weight: var(--weight-bold);
    text-decoration-color: currentColor;
  }
</style>

---
import Symbol from './Symbol.astro'
import { nav, site } from '../site.config.ts'

const path = Astro.url.pathname

/** "page" for the exact page, "true" for pages inside that section. */
function currentState(href: string): 'page' | 'true' | undefined {
  if (path === href) return 'page'
  if (path.startsWith(href)) return 'true'
  return undefined
}
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <Symbol class="symbol" />
      {site.brandName}
    </a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={currentState(item.href)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* The header is a sign-green panel with white type. */
  .site-header {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    justify-content: space-between;
    margin-inline: auto;
    max-width: var(--container);
    padding: var(--space-4) var(--gutter);
  }

  .brand {
    align-items: center;
    color: var(--color-on-accent);
    display: inline-flex;
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand :global(.symbol) {
    flex: none;
    height: 1.25em;
    width: 1.25em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--color-on-accent);
    font-weight: 600;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  nav a:not([aria-current]) {
    text-decoration-color: transparent;
  }

  nav a:hover {
    color: var(--color-on-accent);
    text-decoration-color: currentColor;
  }

  nav a[aria-current] {
    text-decoration-thickness: var(--focus-width);
  }

  .site-header :focus-visible {
    outline-color: var(--color-on-accent);
  }
</style>

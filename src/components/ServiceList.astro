---
import type { CollectionEntry } from 'astro:content'

interface Props {
  services: CollectionEntry<'services'>[]
  /** Heading level for each service name, so the outline never skips. */
  level?: 2 | 3
}

const { services, level = 2 } = Astro.props
const Heading = `h${level}` as 'h2' | 'h3'
---

<ul class="services">
  {services.map((service) => (
    <li>
      <Heading>
        <a href={`/services/${service.id}/`}>{service.data.title}</a>
      </Heading>
      <p>{service.data.summary}</p>
    </li>
  ))}
</ul>

<style>
  /*
   * Spec rows: the service name in the narrow column, what it is in the wide
   * one, on the page's split. The name and the summary share a baseline.
   */
  .services {
    border-top: var(--rule-width) solid var(--color-accent);
    list-style: none;
    padding: 0;
  }

  li {
    align-items: baseline;
    border-bottom: var(--border-width) solid var(--color-border);
    display: grid;
    gap: var(--space-2) var(--split-gap);
    grid-template-columns: var(--split);
    max-width: none;
    padding: var(--space-4) 0 var(--space-5);
  }

  li > :first-child {
    font-size: var(--text-xl);
  }

  li > :first-child a {
    color: var(--color-text);
  }

  li p {
    max-width: 34rem;
  }

  @media (max-width: 40rem) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>

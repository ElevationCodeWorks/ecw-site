---
import type { GetStaticPaths } from 'astro'
import { Picture } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import CallToAction from '../../components/CallToAction.astro'
import { asJsonLd, breadcrumbs } from '../../lib/schema.ts'

export const getStaticPaths = (async () => {
  const projects = await getCollection('work')
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project }
  }))
}) satisfies GetStaticPaths

interface Props {
  project: CollectionEntry<'work'>
}

const { project } = Astro.props
const { data } = project
const { Content } = await render(project)
const path = `/work/${project.id}/`
const host = new URL(data.liveUrl).host

const formatDate = (value: Date | string) =>
  typeof value === 'string'
    ? value
    : value.toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC'
      })
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  jsonLd={[
    asJsonLd(
      breadcrumbs([
        { name: 'Work', path: '/work/' },
        { name: data.name, path }
      ])
    )
  ]}
>
  <article>
    <div class="stack">
      <h1>{data.name}</h1>
      <p class="lede">{data.description}</p>
      <dl class="facts">
        <div>
          <dt>Who it serves</dt>
          <dd>{data.audience}</dd>
        </div>
        <div>
          <dt>My role</dt>
          <dd>{data.role}</dd>
        </div>
        {data.client && (
          <div>
            <dt>Client</dt>
            <dd>{data.client}</dd>
          </div>
        )}
        <div>
          <dt>Live site</dt>
          <dd>
            <a href={data.liveUrl}>{host}</a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="section shots">
      {data.screenshots.map((shot, index) => (
        <figure
          class={shot.viewport}
          style={`--aspect: ${shot.image.width / shot.image.height}`}
        >
          <Picture
            src={shot.image}
            alt={shot.alt}
            formats={['avif', 'webp']}
            widths={shot.viewport === 'mobile' ? [390] : [480, 960, 1440]}
            sizes={
              shot.viewport === 'mobile'
                ? '390px'
                : '(min-width: 78rem) 58rem, (min-width: 40rem) 75vw, 100vw'
            }
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </figure>
      ))}
    </div>

    <div class="section story">
      <Content />
    </div>

    {data.quote && (
      <figure class="section quote">
        <blockquote>
          <p>{data.quote.text}</p>
        </blockquote>
        <figcaption>
          {[data.quote.name, data.quote.role, data.quote.organization]
            .filter(Boolean)
            .join(', ')}
        </figcaption>
      </figure>
    )}

    {data.outcomes.length > 0 && (
      <div class="section spec">
        <section class="row" aria-labelledby="results">
          <h2 id="results">Results</h2>
          <ul class="marks">
            {data.outcomes.map((outcome) => (
              <li>
                {outcome.claim}{' '}
                <span class="source">
                  (Source: {outcome.source}, {formatDate(outcome.measuredAt)})
                </span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    )}

    <CallToAction label="Tell me about your project" href="/contact/" />
  </article>
</BaseLayout>

<style>
  /*
   * One grid for the whole entry: an 18rem label column (the same as the
   * Services list and the service pages) beside the content. Tables open
   * with an ink rule and divide their rows with hairlines.
   */

  /* The facts: a spec table, label on the left, value on its baseline. */
  .facts {
    border-top: var(--rule-width) solid var(--color-accent);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .facts > div {
    align-items: baseline;
    border-bottom: var(--border-width) solid var(--color-border);
    display: grid;
    gap: var(--space-1) var(--space-6);
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    padding-block: var(--space-3);
  }

  dt {
    font-family: var(--font-heading);
    font-weight: var(--weight-bold);
  }

  dd {
    margin: 0;
    max-width: var(--measure);
  }

  /*
   * The screenshots share one height: each takes width in proportion to its
   * aspect ratio, plus its own frame, so their top and bottom edges line up.
   */
  .shots {
    align-items: flex-start;
    display: flex;
    gap: var(--space-5);
  }

  .shots figure {
    flex: var(--aspect) 1 calc(2 * var(--border-width));
    min-width: 0;
  }

  .shots :global(img) {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    width: 100%;
  }

  /*
   * The story: each heading hangs in the label column on the baseline of
   * its first paragraph, under a rule drawn across both columns.
   */
  .story {
    align-items: baseline;
    border-bottom: var(--border-width) solid var(--color-border);
    column-gap: var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    padding-bottom: var(--space-6);
    position: relative;
  }

  .story > :global(*) {
    grid-column: 2;
    margin-top: var(--space-4);
  }

  .story > :global(h2) {
    font-size: var(--text-xl);
    grid-column: 1;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
  }

  .story > :global(h2:first-child) {
    margin-top: 0;
  }

  .story > :global(h2 + *) {
    margin-top: 0;
  }

  .story > :global(h2)::before {
    border-top: var(--border-width) solid var(--color-border);
    content: '';
    display: block;
    left: 0;
    margin-top: calc(-1 * var(--space-5));
    position: absolute;
    right: 0;
  }

  .story > :global(h2:first-child)::before {
    border-top: var(--rule-width) solid var(--color-accent);
  }

  /* Lists: small ink squares hung in the column gap. */
  .story > :global(ul),
  .marks {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .story > :global(ul) > :global(li),
  .marks li {
    position: relative;
  }

  .story > :global(ul) > :global(li)::before,
  .marks li::before {
    background: currentColor;
    content: '';
    height: 0.375em;
    left: calc(-1 * var(--space-5));
    position: absolute;
    top: 0.5625em;
    width: 0.375em;
  }

  /*
   * The client's words, set larger in the content column. The single rule
   * hangs in the column gap, so the quote keeps the text's left edge.
   */
  .quote {
    border-left: var(--rule-width) solid var(--color-accent);
    margin-left: calc(
      18rem + var(--space-6) - var(--space-5) - var(--rule-width)
    );
    padding-left: var(--space-5);
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    font-size: var(--text-xl);
    line-height: 1.4;
    max-width: 58ch;
  }

  .quote figcaption {
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }

  /*
   * Results, if any, as one more spec row: it continues the story's table
   * when nothing comes between them.
   */
  .spec {
    border-top: var(--rule-width) solid var(--color-accent);
  }

  .story + .spec {
    border-top: 0;
    margin-top: 0;
  }

  .row {
    align-items: baseline;
    border-bottom: var(--border-width) solid var(--color-border);
    display: grid;
    gap: var(--space-2) var(--space-6);
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    padding-block: var(--space-5) var(--space-6);
  }

  .row h2 {
    font-size: var(--text-xl);
  }

  .marks {
    font-variant-numeric: lining-nums tabular-nums;
  }

  .source {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Where the content column narrows, the quote steps down a size. */
  @media (max-width: 64rem) {
    .quote blockquote p {
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 40rem) {
    .facts > div,
    .story,
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .story > :global(h2),
    .story > :global(*) {
      grid-column: 1;
    }

    .story > :global(h2 + *) {
      margin-top: var(--space-2);
    }

    .story > :global(ul),
    .marks {
      padding-left: var(--space-5);
    }

    .shots {
      flex-direction: column;
    }

    .shots figure {
      flex: none;
      width: 100%;
    }

    .shots figure.mobile {
      width: min(100%, 14rem);
    }

    .quote {
      margin-left: 0;
    }
  }
</style>

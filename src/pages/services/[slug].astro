---
import type { GetStaticPaths } from 'astro'
import { getEntries, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import CallToAction from '../../components/CallToAction.astro'
import { getServices } from '../../lib/services.ts'
import { asJsonLd, breadcrumbs, serviceEntity } from '../../lib/schema.ts'

export const getStaticPaths = (async () => {
  const services = await getServices()
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service }
  }))
}) satisfies GetStaticPaths

interface Props {
  service: CollectionEntry<'services'>
}

const { service } = Astro.props
const { data } = service
const { Content } = await render(service)
const related = await getEntries(data.relatedWork)
const path = `/services/${service.id}/`

const jsonLd = [
  asJsonLd(
    serviceEntity({ name: data.title, description: data.summary, path })
  ),
  asJsonLd(
    breadcrumbs([
      { name: 'Services', path: '/services/' },
      { name: data.title, path }
    ])
  )
]
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  jsonLd={jsonLd}
>
  <article>
    <div class="page-intro">
      <h1>{data.title}</h1>
      <div class="stack">
        <p class="lede">{data.summary}</p>
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    <div class="section spec">
      <section class="row" aria-labelledby="for-who">
        <h2 id="for-who">Who it's for</h2>
        <div>
          <p>{data.forWho}</p>
        </div>
      </section>

      <section class="row" aria-labelledby="included">
        <h2 id="included">What's included</h2>
        <div>
          <ul class="marks">
            {data.included.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="row" aria-labelledby="not-included">
        <h2 id="not-included">What's not included</h2>
        <div>
          <ul class="marks excluded">
            {data.notIncluded.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      {related.length > 0 && (
        <section class="row" aria-labelledby="related">
          <h2 id="related">Related work</h2>
          <div>
            <ul class="marks">
              {related.map((project) => (
                <li>
                  <a href={`/work/${project.id}/`}>{project.data.name}</a>:{' '}
                  {project.data.description}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </div>

    <CallToAction
      label={
        data.isEntryOffer ? 'Book a tech checkup' : 'Tell me about your project'
      }
      href="/contact/"
    />
  </article>
</BaseLayout>

<style>
  /*
   * Spec rows, ruled like a catalog table: an ink rule opens it and hairlines
   * divide the rows. Each heading sits in the label column of the 3:5 split, as on the
   * Services list, on the baseline of its row's first line.
   */
  .spec {
    border-top: var(--rule-width) solid var(--color-accent);
  }

  .row {
    align-items: baseline;
    border-bottom: var(--border-width) solid var(--color-border);
    display: grid;
    gap: var(--space-2) var(--split-gap);
    grid-template-columns: var(--split);
    padding-block: var(--space-5) var(--space-6);
  }

  .row h2 {
    font-size: var(--text-xl);
  }

  /*
   * What's included is marked with small ink squares, what's not with a
   * short rule, a minus. The marks hang in the column gap, so the text keeps
   * the column's edge.
   */
  .marks {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .marks li {
    position: relative;
  }

  /* Both marks center on the x-height of the item's first line. */
  .marks li::before {
    background: currentColor;
    content: '';
    height: 0.375em;
    left: calc(-1 * var(--space-5));
    position: absolute;
    top: 0.5625em;
    width: 0.375em;
  }

  .excluded li::before {
    height: 0.125em;
    top: 0.6875em;
    width: 0.625em;
  }

  @media (max-width: 40rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .marks {
      padding-left: var(--space-5);
    }
  }
</style>

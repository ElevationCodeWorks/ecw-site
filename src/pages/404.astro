---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPage } from '../lib/pages.ts'

const { data } = await getPage('not-found')
const links = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Work', href: '/work/' },
  { label: 'Contact', href: '/contact/' }
]
---

<BaseLayout title={data.seo.title} description={data.seo.description} noindex>
  <div class="stack">
    <h1>{data.h1}</h1>
    {data.lede && <p class="lede">{data.lede}</p>}
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .links {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
  }
</style>

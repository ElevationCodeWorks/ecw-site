---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPage } from '../lib/pages.ts'

const { data } = await getPage('not-found')
const links = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Work', href: '/work/' },
  { label: 'Contact', href: '/contact/' }
]
---

<BaseLayout title={data.seo.title} description={data.seo.description} noindex>
  <div class="stack">
    <h1>{data.h1}</h1>
    {data.lede && <p class="lede">{data.lede}</p>}
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  /*
   * The way out, set as a short index of large links, ruled like the spec
   * tables: an ink rule opens it, hairlines divide the rows. Each link fills
   * its row, so the whole row is the target and the focus ring frames it;
   * the row reaches a little into the gutter so the ring clears the text.
   */
  .links {
    border-top: var(--rule-width) solid var(--color-accent);
    list-style: none;
    padding: 0;
  }

  .stack > .links {
    margin-top: var(--space-7);
  }

  .links li {
    border-bottom: var(--border-width) solid var(--color-border);
    max-width: none;
  }

  .links a {
    color: var(--color-text);
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    margin-inline: calc(-1 * var(--space-3));
    padding: var(--space-4) var(--space-3);
    text-decoration: none;
    text-underline-offset: 0.12em;
  }

  .links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
  }
</style>

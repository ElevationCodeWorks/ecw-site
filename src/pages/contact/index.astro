---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPage } from '../../lib/pages.ts'
import { getServices } from '../../lib/services.ts'
import { asJsonLd, breadcrumbs } from '../../lib/schema.ts'
import { site } from '../../site.config.ts'

const { data } = await getPage('contact')
const services = await getServices()
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  jsonLd={[asJsonLd(breadcrumbs([{ name: 'Contact', path: '/contact/' }]))]}
>
  <div class="page-intro">
    <h1>{data.h1}</h1>
    <div class="stack">
      {data.lede && <p class="lede">{data.lede}</p>}
      <p>
        Prefer email? Write to{' '}
        <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>.
      </p>
    </div>
  </div>

  {/*
    Netlify Forms (design D11): detected in the built HTML at deploy time.
    Works without JavaScript; the browser enforces the input rules.
  */}
  <form
    class="section form"
    name="contact"
    method="POST"
    action="/contact/thanks/"
    data-netlify="true"
    netlify-honeypot="bot-field"
  >
    <input type="hidden" name="form-name" value="contact" />
    <input
      type="hidden"
      name="subject"
      data-remove-prefix
      value="Website inquiry: Elevation Code Works"
    />
    <p hidden>
      <label>
        Leave this field empty <input name="bot-field" />
      </label>
    </p>

    <p class="field">
      <label for="name">
        Name <span class="req">(required)</span>
      </label>
      <input id="name" name="name" autocomplete="name" required />
    </p>

    <p class="field">
      <label for="email">
        Email <span class="req">(required)</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      />
    </p>

    <p class="field">
      <label for="business">
        Business name <span class="opt">(optional)</span>
      </label>
      <input id="business" name="business" autocomplete="organization" />
    </p>

    <p class="field">
      <label for="service">
        What do you need? <span class="opt">(optional)</span>
      </label>
      <span class="select">
        <select id="service" name="service">
          <option value="">Choose one</option>
          {services.map((service) => (
            <option value={service.data.title}>{service.data.title}</option>
          ))}
          <option value="Not sure yet">Not sure yet</option>
        </select>
      </span>
    </p>

    <p class="field">
      <label for="message">
        Message <span class="req">(required, at least 10 characters)</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="8"
        minlength="10"
        maxlength="5000"
        required
      ></textarea>
    </p>

    <p class="data-use">{data.dataUse}</p>

    <p class="send">
      <button type="submit">Send message</button>
    </p>
  </form>
</BaseLayout>

<style>
  /*
   * The form is a spec table on the page's split: an ink rule opens it and
   * hairlines divide the rows. Each label sits in the narrow column, set
   * like a case study's row labels, with the field's rule under it; the
   * field fills the wide column to the body measure, its text on the
   * label's baseline. The note on how a message is used, and the send
   * button, follow in the wide column.
   */
  .form {
    border-top: var(--rule-width) solid var(--color-accent);
    column-gap: var(--split-gap);
    display: grid;
    grid-template-columns: var(--split);
  }

  .field {
    align-items: baseline;
    border-bottom: var(--border-width) solid var(--color-border);
    display: grid;
    gap: var(--space-2) var(--split-gap);
    grid-column: 1 / -1;
    grid-template-columns: var(--split);
    max-width: none;
    padding-block: var(--space-4);
  }

  .field > :last-child {
    max-width: var(--measure);
  }

  label {
    font-family: var(--font-heading);
    font-weight: var(--weight-bold);
  }

  .req,
  .opt {
    color: var(--color-text-muted);
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
  }

  /*
   * A field is drawn with a hairline in ink, twice as heavy while it has
   * focus or holds a rejected entry. The padding gives back whatever the
   * border takes, so the field keeps its size and its text stays put.
   */
  input,
  select,
  textarea {
    --edge: var(--border-width);
    appearance: none;
    background: var(--color-bg);
    border: var(--edge) solid var(--color-border-strong);
    border-radius: var(--radius);
    padding: calc(var(--space-2) + 2 * var(--border-width) - var(--edge))
      calc(var(--space-3) + 2 * var(--border-width) - var(--edge));
    width: 100%;
  }

  textarea {
    resize: vertical;
  }

  /* The menu gets the same square field, with its arrow drawn in ink. */
  .select {
    display: block;
    position: relative;
  }

  .select::after {
    background: currentColor;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    content: '';
    height: 0.375em;
    pointer-events: none;
    position: absolute;
    right: var(--space-4);
    top: calc(50% - 0.1875em);
    width: 0.75em;
  }

  select {
    cursor: pointer;
    padding-right: calc(
      var(--space-4) * 2 + 0.75em + 2 * var(--border-width) - var(--edge)
    );
  }

  /*
   * After the visitor has tried, a rejected entry shows in the error color,
   * and so does the rule under its label.
   */
  input:user-invalid,
  textarea:user-invalid,
  select:user-invalid {
    --edge: calc(2 * var(--border-width));
    border-color: var(--color-error);
  }

  .field:has(:user-invalid) .req {
    color: var(--color-error);
  }

  /*
   * Focus gets the site's ring, drawn lighter here (2px, 2px off the
   * field) so it doesn't stack into a heavy block around a rejected entry.
   */
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline-offset: 2px;
    outline-width: 2px;
  }

  .data-use,
  .send {
    grid-column: 2;
  }

  .data-use {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
  }

  .send {
    margin-top: var(--space-5);
  }

  button {
    background: var(--color-highlight);
    border: 0;
    border-radius: var(--radius);
    color: var(--color-on-highlight);
    cursor: pointer;
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    padding: var(--space-4) var(--space-6);
    text-underline-offset: 0.2em;
  }

  button:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* On a phone each label sits over its field, its rule beside it. */
  @media (max-width: 40rem) {
    .form,
    .field {
      grid-template-columns: minmax(0, 1fr);
    }

    .data-use,
    .send {
      grid-column: 1;
    }

    .req,
    .opt {
      display: inline;
    }
  }
</style>

{
  "name": "ecw-site",
  "private": true,
  "type": "module",
  "description": "Elevation Code Works website",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check:site": "node integrations/site-check/cli.ts",
    "check:structure": "npm run build && node scripts/structure-snapshot.ts check",
    "release-check": "node scripts/release-check.ts",
    "audit": "node scripts/audit.mjs",
    "test": "node --test \"src/**/*.test.ts\" \"integrations/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.8",
    "satori": "0.63.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@capsizecss/core": "4.1.3",
    "@capsizecss/metrics": "4.4.0",
    "@capsizecss/unpack": "4.0.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/archivo-narrow": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/archivo-narrow": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@lhci/cli": "^0.16.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "axe-core": "^4.14.0",
    "culori": "^4.0.2",
    "node-html-parser": "^9.0.7",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "schema-dts": "^2.1.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}

{
  "name": "ecw-site",
  "private": true,
  "type": "module",
  "description": "Elevation Code Works website",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "node --test \"src/**/*.test.ts\" \"integrations/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@lhci/cli": "^0.16.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "culori": "^4.0.2",
    "node-html-parser": "^9.0.7",
    "pa11y-ci": "^5.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "schema-dts": "^2.1.0",
    "typescript": "^6.0.3"
  }
}
